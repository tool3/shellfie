{
  "name": "snaptty",
  "version": "0.1.0",
  "description": "Convert terminal output to crystal-clear SVG images",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npx tsx example.ts"
  },
  "keywords": [
    "terminal",
    "svg",
    "screenshot",
    "ansi",
    "tty",
    "cli"
  ],
  "author": "tool3",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chartscii": "^3.2.0"
  }
}
