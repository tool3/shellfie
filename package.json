{
  "name": "shellfie",
  "version": "2.0.19",
  "description": "Convert terminal output to crystal-clear SVG images",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "module": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npx tsx example.ts"
  },
  "keywords": [
    "terminal",
    "svg",
    "screenshot",
    "ansi",
    "tty",
    "cli"
  ],
  "author": "tool3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tool3/shellfie"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "chartscii": "^3.2.0",
    "gradient-string": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
